{
  "name": "@actualised-ai/sdk",
  "version": "0.1.0",
  "description": "SDK for Actualised AI autonomous multi-agent orchestration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "actualised_sdk.*.node"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sejori/actualised-ai.git",
    "directory": "packages/sdk"
  },
  "napi": {
    "binaryName": "actualised_sdk"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build:native": "napi build --platform --release",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "napi build --platform --release && tsc -p tsconfig.build.json",
    "build:debug": "napi build --platform && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
